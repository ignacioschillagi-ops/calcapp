{
  "id": "/",
  "name": "Calcapp — Calcá con la cámara",
  "short_name": "Calcapp",
  "description": "Calcá cualquier imagen sobre papel usando la cámara de tu celular. By @YoSoyJoe.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F2FBF8",
